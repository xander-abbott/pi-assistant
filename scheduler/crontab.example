SHELL=/bin/bash
PATH=/home/xanderabbott/assistant/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Scheduler tick — runs every 15 min, fires any due messages for all active users
*/15 * * * * cd /home/xanderabbott/assistant && venv/bin/python sender.py tick >> logs/tick.log 2>&1

# Link checkin responses to weekly goals — runs once nightly
30 23 * * * cd /home/xanderabbott/assistant && venv/bin/python etl/link_responses.py >> logs/etl.log 2>&1

# Load weekly goals from per-user JSON files — runs Monday morning before first tick
0 6 * * 1 cd /home/xanderabbott/assistant && venv/bin/python etl/load_weekly_goals.py >> logs/etl.log 2>&1
